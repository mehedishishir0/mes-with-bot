# আপনার ওয়েবসাইটের URL (Vercel URL অথবা লোকালহোস্ট)
# উদাহরণ: https://your-mess.vercel.app অথবা http://localhost:3000
WEBSITE_API_URL=http://localhost:3000

# সিকিউর Bot Secret Key (ওয়েবসাইটের .env ফাইলে থাকা BOT_SECRET_KEY এর সাথে মিল থাকতে হবে)
BOT_SECRET_KEY=mess_bot_secret_2026

# আপনার হোয়াটসঅ্যাপ গ্রুপের নাম (অথবা সরাসরি গ্রুপ JID)
# বট চালু হলে সে আপনার গ্রুপগুলোর তালিকা দেখিয়ে দিবে, যেখান থেকে নাম বা আইডি কপি করতে পারবেন
WHATSAPP_GROUP_NAME=

# নির্দিষ্ট গ্রুপ JID (যদি জানা থাকে, যেমন: 120363xxxxxx@g.us)
WHATSAPP_GROUP_ID=

# টাইমজোন
TIMEZONE=Asia/Dhaka
